# This folder holds the couple's photo only. As a safety measure, never allow
# any script to run from here — serve files as static content only.
<IfModule mod_php.c>
    php_admin_flag engine off
</IfModule>
<FilesMatch "\.(php|phar|phtml|pht|php[0-9])$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>
